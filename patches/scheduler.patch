diff --git a/python/sglang/srt/managers/scheduler_lab.py b/python/sglang/srt/managers/scheduler_lab.py
new file mode 100644
index 0000000..82bd5b9
--- /dev/null
+++ b/python/sglang/srt/managers/scheduler_lab.py
@@ -0,0 +1,230 @@
+"""单卡调度实验：排序、内存记录与独立 GPU 标定。"""
+
+import csv
+import heapq
+import json
+import math
+import os
+import time
+from functools import wraps
+from pathlib import Path
+
+POLICIES = {"short-input", "short-remaining", "aged-remaining", "aged-cost"}
+
+
+class RemainingPolicy:
+    def __init__(self, name, limit=64, threshold_ms=500, model_path=None):
+        if limit < 0 or not math.isfinite(threshold_ms) or threshold_ms < 0:
+            raise ValueError("候选数量和等待阈值必须为非负数")
+        self.name, self.limit, self.threshold_ms = name, limit, threshold_ms
+        self.beta = None
+        if name == "aged-cost":
+            if not model_path:
+                raise ValueError("aged-cost 需要 --schedule-cost-model")
+            model = json.loads(Path(model_path).read_text(encoding="utf-8"))
+            self.beta = model["beta"]
+            if len(self.beta) != 3 or any(
+                not math.isfinite(x) or x < 0 for x in self.beta
+            ):
+                raise ValueError("成本模型需要三个非负有限系数")
+            if model["unit"] != "ms":
+                raise ValueError("成本模型单位必须为 ms")
+
+    def order(self, queue, match, now=None):
+        now = time.perf_counter() if now is None else now
+        aged, ordinary = [], []
+        for req in queue:
+            target = (
+                aged
+                if self.name.startswith("aged-")
+                and (
+                    (now - req.time_stats.wait_queue_entry_time) * 1000
+                    >= self.threshold_ms
+                )
+                else ordinary
+            )
+            target.append(req)
+        arrival = lambda r: r.lab_arrival_seq
+        candidates = (
+            heapq.nsmallest(self.limit, ordinary, key=arrival)
+            if self.limit
+            else ordinary
+        )
+        chosen = {id(r) for r in candidates}
+        tail = [r for r in ordinary if id(r) not in chosen]
+        scores = {}
+        for req in candidates:
+            if self.name == "short-input":
+                cost = len(req.origin_input_ids)
+            else:
+                length = len(req.origin_input_ids) + len(req.output_ids)
+                hit = min(match(req), req._compute_max_prefix_len(length))
+                remaining = max(0, length - hit)
+                cost = (
+                    remaining
+                    if self.beta is None
+                    else (
+                        self.beta[0]
+                        + self.beta[1] * remaining
+                        + self.beta[2]
+                        * (hit * remaining + remaining * (remaining + 1) / 2)
+                    )
+                )
+            scores[id(req)] = cost
+        queue[:] = (
+            sorted(aged, key=arrival)
+            + sorted(candidates, key=lambda r: (scores[id(r)], arrival(r)))
+            + tail
+        )
+        return len(candidates), len(aged)
+
+
+class Trace:
+    def __init__(self):
+        self.directory = None
+        self.requests = {}
+        self.calls = []
+        self.gpu = []
+        self.sequence = 0
+        self.rids = []
+        self.matches = {"scoring": [0, 0.0, 0.0], "admission": [0, 0.0, 0.0]}
+        self.calibrate = os.environ.get("SGLANG_LAB_CALIBRATE") == "1"
+
+    def enqueue(self, req, retracted):
+        req.lab_arrival_seq = self.sequence
+        self.sequence += 1
+        if self.directory:
+            row = self.requests.setdefault(
+                req.rid,
+                dict(
+                    rid=req.rid,
+                    input_tokens=len(req.origin_input_ids),
+                    first_enqueue_s=req.time_stats.wait_queue_entry_time,
+                    first_admit_s=None,
+                    retractions=0,
+                ),
+            )
+            row["retractions"] += int(retracted)
+
+    def admit(self, reqs):
+        if self.directory:
+            now = time.perf_counter()
+            for req in reqs:
+                row = self.requests.get(req.rid)
+                if row is not None and row["first_admit_s"] is None:
+                    row["first_admit_s"] = now
+
+    def dump(self):
+        if not self.directory:
+            return
+        directory = Path(self.directory)
+        directory.mkdir(parents=True, exist_ok=True)
+        (directory / "server-trace.json").write_text(
+            json.dumps({"snapshot_s": time.perf_counter()}) + "\n", encoding="utf-8"
+        )
+        for filename, rows in (
+            ("server-requests.jsonl", self.requests.values()),
+            ("gpu.jsonl", self.gpu),
+        ):
+            with (directory / filename).open("w", encoding="utf-8") as f:
+                for row in rows:
+                    f.write(json.dumps(row) + "\n")
+        if self.calls:
+            fields = sorted({key for row in self.calls for key in row})
+            with (directory / "scheduling.csv").open(
+                "w", newline="", encoding="utf-8"
+            ) as f:
+                writer = csv.DictWriter(f, fieldnames=fields)
+                writer.writeheader()
+                writer.writerows(self.calls)
+
+
+trace = Trace()
+
+
+def measured(kind):
+    def decorate(fn):
+        @wraps(fn)
+        def wrapped(self, *args, **kwargs):
+            if not trace.directory or (
+                kind == "prefill_total"
+                and not self.waiting_queue
+                and self.chunked_req is None
+            ):
+                return fn(self, *args, **kwargs)
+            start, cpu = time.perf_counter(), time.thread_time()
+            queue = args[0] if kind == "priority" else self.waiting_queue
+            row = dict(kind=kind, start_s=start, queue_len=len(queue))
+            previous = {key: value[:] for key, value in trace.matches.items()}
+            if kind == "priority":
+                row["policy"] = self.policy.value
+                row["effective_policy"] = self._determine_active_policy(queue).value
+            try:
+                return fn(self, *args, **kwargs)
+            finally:
+                row.update(
+                    wall_ms=(time.perf_counter() - start) * 1000,
+                    cpu_ms=(time.thread_time() - cpu) * 1000,
+                )
+                for phase, totals in trace.matches.items():
+                    for i, suffix in enumerate(("calls", "wall_ms", "cpu_ms")):
+                        row[f"{phase}_{suffix}"] = totals[i] - previous[phase][i]
+                trace.calls.append(row)
+
+        return wrapped
+
+    return decorate
+
+
+def measured_match(phase):
+    def decorate(fn):
+        @wraps(fn)
+        def wrapped(*args, **kwargs):
+            if not trace.directory:
+                return fn(*args, **kwargs)
+            start, cpu = time.perf_counter(), time.thread_time()
+            try:
+                return fn(*args, **kwargs)
+            finally:
+                totals = trace.matches[phase]
+                totals[0] += 1
+                totals[1] += (time.perf_counter() - start) * 1000
+                totals[2] += (time.thread_time() - cpu) * 1000
+
+        return wrapped
+
+    return decorate
+
+
+def gpu_forward(fn):
+    @wraps(fn)
+    def wrapped(self, forward_batch, *args, **kwargs):
+        if (
+            not trace.calibrate
+            or not trace.rids
+            or not forward_batch.forward_mode.is_extend()
+        ):
+            return fn(self, forward_batch, *args, **kwargs)
+        import torch
+
+        if len(trace.rids) != 1:
+            raise ValueError("GPU 标定只支持独占单请求 prefill")
+        start, end = (
+            torch.cuda.Event(enable_timing=True),
+            torch.cuda.Event(enable_timing=True),
+        )
+        start.record()
+        result = fn(self, forward_batch, *args, **kwargs)
+        end.record()
+        end.synchronize()
+        trace.gpu.append(
+            dict(
+                rid=trace.rids[0],
+                gpu_ms=start.elapsed_time(end),
+                hit=forward_batch.extend_prefix_lens_cpu[0],
+                remaining=forward_batch.extend_seq_lens_cpu[0],
+            )
+        )
+        return result
+
+    return wrapped
